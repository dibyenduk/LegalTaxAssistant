        <mxCell id="pElz31CkjSHs_Up43ZBx-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="User vkankalia@MngEnvMCAP629447.onmicrosoft.com&amp;nbsp; (Tax Expert) is logged into teams&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
